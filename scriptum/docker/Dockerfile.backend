FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy README (referenced by pyproject.toml as ../README.md)
COPY README.md /README.md

# Install Python dependencies first (cached layer)
COPY scriptum/pyproject.toml .
RUN pip install --no-cache-dir ".[dev]"

# Copy application code
COPY scriptum/backend/ backend/
COPY scriptum/agents/ agents/
COPY scriptum/tools/ tools/
COPY scriptum/cli/ cli/
COPY scriptum/config/ config/
COPY scriptum/alembic.ini .

# Create data directories
RUN mkdir -p /root/.scriptum/logs

# Entrypoint script for migrations + startup
COPY scriptum/docker/entrypoint.backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
