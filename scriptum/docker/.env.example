# SCRIPTUM Docker Environment Variables
# Copy to docker/.env and fill in your values:
#   cp docker/.env.example docker/.env

# ── Ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
GROBID_PORT=8070
CHROMADB_PORT=8001

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=scriptum
POSTGRES_USER=scriptum
POSTGRES_PASSWORD=scriptum

# ── LLM API Keys (optional — can also set via Settings UI) ──────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── MCP Tools (optional) ────────────────────────────────────────────
# PERPLEXITY_API_KEY=pplx-...
# GOOGLE_SEARCH_API_KEY=AIza...
# GOOGLE_SEARCH_CX=...

# ── Research APIs (optional) ────────────────────────────────────────
# SEMANTIC_SCHOLAR_API_KEY=...
